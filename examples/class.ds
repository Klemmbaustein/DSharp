using system::io
using system

module classExample

class BaseClass
{
	virtual fn f()
	{
		writeln("Base function")
	}
}

class Derived : BaseClass
{
	virtual fn f()
	{
		writeln("Derived function")
	}
}

[EntryPoint]
fn example()
{
	BaseClass c = new Derived()

	c.f()

	// Output:
	// Derived function
}
