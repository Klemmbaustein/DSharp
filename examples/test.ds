using system::io
using system

module helloWorld

class c
{
	fn delete()
	{
		writeln("bye")
	}
}

fn doUnwind()
{
	string s = "hi"

	err::abort()
}

[EntryPoint]
fn main()
{
	var i = new c()

	var thing = fn()
	{
		var b = i
		writeln("unwind b")
	}

	if true
	{
		thing.call()
		doUnwind()
	}

	writeln("unwind aaa")
}
