using system::io
using system

module functionReferences

[EntryPoint]
fn example()
{
	// Regular function
	fn() -> int reference = getNumberFunction

	writeInt(reference.call())

	// Function class
	reference = new GetNumberFunctionClass(5)

	writeInt(reference.call())

	// Lambda
	reference = fn() -> int
	{
		return 10
	}

	writeInt(reference.call())

	// Output:
	// 1
	// 5
	// 10
}

fn getNumberFunction() -> int
{
	return 2
}

class GetNumberFunctionClass : fn() -> int
{
	int number

	fn new(int number)
	{
		this.number = number
	}

	override fn call() -> int
	{
		return number
	}
}