using system

module test

class A
{
	string message = "hi"

	virtual fn test()
	{
		println(this.message)
	}
}

class B : A
{
	fn new()
	{
		this.message = "hi B"
	}

	override fn test()
	{
		println($"overriden message: {this.message}")
	}
}

[EntryPoint]
fn main() -> int
{
	A test = new B()

	test.test()

	test = new A()

	test.test()

	return 0
}
