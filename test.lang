using system

module test

class A
{
	string message = "hi"

	fn delete()
	{
		io::writeln("bye")
	}

	virtual fn sayHi()
	{
		io::writeln(message)
	}
}

class B : A
{
	override fn sayHi()
	{
		io::writeln($"message: {message}")
	}
}

[Discard]
fn a() -> A
{
	return new B()
}

[EntryPoint]
fn main() -> int
{
	A x

	if true
	{
		x = a()
	}

	x.sayHi()

	return 0
}
