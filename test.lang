using system
using system::io
using commands

module test

[EntryPoint]
fn main() -> int
{
	Command[] commandList = []
	commandList.push(new ListCommand())
	commandList.push(new CurrentDirCommand())

	while true
	{
		write("> ")
		const givenCommand = readln()

		if givenCommand == "exit"
		{
			break
		}
		execute(commandList, givenCommand)
	}
	return 0
}


fn execute(Command[] commandList, string givenCommand)
{
	int i = 0
	while i < commandList.length
	{
		const current = commandList[i]
		if current.name == givenCommand
		{
			current.execute()
			return
		}
		i += 1
	}

	writeln($"unknown command: {givenCommand}")
}
