using system

module test

fn getGreeting(string address, string to) -> string
{
	return $"{address}, {to}"
}

class Greeter
{
	string message
	fn new(string message)
	{
		this.message = message
	}

	fn delete()
	{
		println(getGreeting("bye", message))
	}

	fn greet()
	{
		println(getGreeting("hello", message))
	}
}

[EntryPoint]
fn fibonacci() -> int
{
	while true
	{
		new Greeter("world").greet()
	}
	return 0
}
