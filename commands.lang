using system::io
using system::fs

module commands

class Command
{
	string name

	virtual fn execute()
	{

	}
}

class ListCommand : Command
{
	fn new()
	{
		this.name = "ls"
	}

	override fn execute()
	{
		FilePath[] paths = getCurrentPath().getFiles()

		int i = 0

		while i < paths.length
		{
			writeln("  " + paths[i].name())
			i += 1
		}
	}
}

class CurrentDirCommand : Command
{
	fn new()
	{
		this.name = "pwd"
	}

	override fn execute()
	{
		writeln(getCurrentPath().full())
	}
}
