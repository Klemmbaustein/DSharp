using system::io
using system

module classExample

interface MyInterface
{
	virtual fn f2()
	{
		writeln("Interface function")
	}
}

class BaseClass
{
	virtual fn f()
	{
		writeln("Base function")
	}
}

class Derived : BaseClass, is MyInterface
{
	override fn f()
	{
		writeln("Derived function")
	}
}

[EntryPoint]
fn example()
{
	BaseClass c = new Derived()

	c.f()

	(c as MyInterface).f2()

	// Output:
	// Derived function
	// Interface function
}
